<?xml version="1.0" encoding="utf-8"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://qconsulting.ca/fo3/ModConfig5.0.xsd">
	<moduleName>SeamlessSkyrim</moduleName>
	<requiredInstallFiles>
		<folder source="Core" destination="" />
	</requiredInstallFiles>
	<installSteps order="Explicit">
		<installStep name="Community Shaders or Bottled Shaders">
			<optionalFileGroups order="Explicit">
				<!-- A forced choice: Vortex answers fileDependency from its plugin list, which never holds
				     these files, so only MO2 can preselect the right answer; the texts name the versions.
				     Each patch replaces the DLL and some shaders and fits one release exactly.
				     Told apart by feature files (patterns: the first match wins):
				     - Bottled Shaders (same CommunityShaders.dll): Snow Cover, Hair Backlighting, only it has.
				     - Bottled Shaders 2.0 against 1.0: Rainbows, new in 2.0 (with Snow Cover, in case
				       Community Shaders takes it over).
				     - Community Shaders 2.0 against 1.9: View Atmosphere, Scene Manager, new in 2.0. -->
				<group name="Which Community Shaders or Bottled Shaders do you use?" type="SelectExactlyOne">
					<plugins order="Explicit">
						<plugin name="Community Shaders 1.9.1">
							<description>Installs a patch for Community Shaders 1.9.1 that draws the rooms behind doors with their own light. SeamlessSkyrim must win its file conflicts with Community Shaders and Skylighting. Not for any other version of Community Shaders, nor Bottled Shaders: it replaces their DLL and shaders with Community Shaders 1.9.1's and breaks them.</description>
							<files>
								<folder source="CommunityShaders-1.9.1" destination="" />
							</files>
							<typeDescriptor>
								<dependencyType>
									<defaultType name="Optional" />
									<patterns>
										<pattern>
											<dependencies operator="Or">
												<fileDependency file="Shaders\Features\SnowCover.ini" state="Active" />
												<fileDependency file="Shaders\Features\HairBacklighting.ini" state="Active" />
												<fileDependency file="Shaders\Features\ViewAtmosphere.ini" state="Active" />
												<fileDependency file="Shaders\Features\SceneManager.ini" state="Active" />
											</dependencies>
											<type name="NotUsable" />
										</pattern>
										<pattern>
											<dependencies operator="And">
												<fileDependency file="SKSE\Plugins\CommunityShaders.dll" state="Active" />
											</dependencies>
											<type name="Recommended" />
										</pattern>
									</patterns>
								</dependencyType>
							</typeDescriptor>
						</plugin>
						<plugin name="Community Shaders 2.0.0-rc.2">
							<description>Installs a patch for Community Shaders 2.0.0-rc.2 that draws the rooms behind doors with their own light. SeamlessSkyrim must win its file conflicts with Community Shaders. Not for any other version of Community Shaders, nor Bottled Shaders: it replaces their DLL and shaders with Community Shaders 2.0.0-rc.2's and breaks them. Community Shaders 2.0 switches itself off when Dynamic Terrain Deformation (NMN_DeformableTerrain.dll) is installed, and the rooms behind doors are then drawn by no one.</description>
							<files>
								<folder source="CommunityShaders-2.0" destination="" />
							</files>
							<typeDescriptor>
								<dependencyType>
									<defaultType name="Optional" />
									<patterns>
										<pattern>
											<dependencies operator="Or">
												<fileDependency file="Shaders\Features\SnowCover.ini" state="Active" />
												<fileDependency file="Shaders\Features\HairBacklighting.ini" state="Active" />
											</dependencies>
											<type name="NotUsable" />
										</pattern>
										<pattern>
											<dependencies operator="Or">
												<fileDependency file="Shaders\Features\ViewAtmosphere.ini" state="Active" />
												<fileDependency file="Shaders\Features\SceneManager.ini" state="Active" />
											</dependencies>
											<type name="Recommended" />
										</pattern>
										<pattern>
											<dependencies operator="And">
												<fileDependency file="SKSE\Plugins\CommunityShaders.dll" state="Active" />
											</dependencies>
											<type name="NotUsable" />
										</pattern>
									</patterns>
								</dependencyType>
							</typeDescriptor>
						</plugin>
						<plugin name="Bottled Shaders 2.0.3">
							<description>Installs a patch for Bottled Shaders 2.0.3 that draws the rooms behind doors with their own light. SeamlessSkyrim must win its file conflicts with Bottled Shaders. Not for any other version of Bottled Shaders, nor Community Shaders: it replaces their DLL and shaders with Bottled Shaders 2.0.3's and breaks them. Bottled Shaders switches itself off when Dynamic Terrain Deformation (NMN_DeformableTerrain.dll) is installed, and the rooms behind doors are then drawn by no one.</description>
							<files>
								<folder source="BottledShaders-2.0.3" destination="" />
							</files>
							<typeDescriptor>
								<dependencyType>
									<defaultType name="Optional" />
									<patterns>
										<pattern>
											<dependencies operator="And">
												<fileDependency file="Shaders\Features\SnowCover.ini" state="Active" />
												<fileDependency file="Shaders\Features\Rainbows.ini" state="Active" />
											</dependencies>
											<type name="Recommended" />
										</pattern>
										<pattern>
											<dependencies operator="And">
												<fileDependency file="SKSE\Plugins\CommunityShaders.dll" state="Active" />
											</dependencies>
											<type name="NotUsable" />
										</pattern>
									</patterns>
								</dependencyType>
							</typeDescriptor>
						</plugin>
						<plugin name="None of these">
							<description>No Community Shaders or Bottled Shaders, or a version not listed. Doors still open without a loading screen, but the rooms behind them aren't drawn into the street.</description>
							<files />
							<typeDescriptor>
								<dependencyType>
									<defaultType name="Optional" />
									<patterns>
										<pattern>
											<dependencies operator="And">
												<fileDependency file="Shaders\Features\SnowCover.ini" state="Active" />
												<fileDependency file="Shaders\Features\Rainbows.ini" state="Active" />
											</dependencies>
											<type name="Optional" />
										</pattern>
										<pattern>
											<dependencies operator="Or">
												<fileDependency file="Shaders\Features\SnowCover.ini" state="Active" />
												<fileDependency file="Shaders\Features\HairBacklighting.ini" state="Active" />
											</dependencies>
											<type name="Recommended" />
										</pattern>
										<pattern>
											<dependencies operator="And">
												<fileDependency file="SKSE\Plugins\CommunityShaders.dll" state="Missing" />
											</dependencies>
											<type name="Recommended" />
										</pattern>
									</patterns>
								</dependencyType>
							</typeDescriptor>
						</plugin>
					</plugins>
				</group>
			</optionalFileGroups>
		</installStep>
	</installSteps>
</config>
